# Copy to deploy/.env and edit. Production values shown; local overrides in comments.

# Public honeypot ports. Locally use 2222 / 2323 so nothing fights the host.
HONEYPOT_SSH_PORT=22
HONEYPOT_TELNET_PORT=23
# Locally: 127.0.0.1 keeps the test honeypot off your LAN.
HONEYPOT_BIND=0.0.0.0

# Your own IP or network. Events from it are dropped before aggregation, so a
# mistyped real password on port 22 can never be published. Comma-separated.
ADMIN_CIDR=

# Collector
STATS_DAYS=30
STATS_DATASET=live
COLLECT_INTERVAL=600
GEOIP_DIR=../data/geoip

# Stats endpoint (docker compose --profile publish). A DNS name pointing at the
# VPS gets automatic HTTPS; ":8080" serves plain HTTP for local testing.
STATS_SITE=stats.example.com
CORS_ORIGIN=https://saafirhale.com
ACME_EMAIL=
STATS_HTTP_PORT=80
STATS_HTTPS_PORT=443

# Pin images. Update deliberately (see docs/RUNBOOK.md).
COWRIE_IMAGE=cowrie/cowrie:3.1.4
CADDY_IMAGE=caddy:2.11.7-alpine
